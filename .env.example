APP_NAME=BolãoVF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Banco de dados ───────────────────────────────────────────────────────────
# DB_HOST deve ser "mysql" quando rodando via Docker Compose.
# DB_EXTERNAL_PORT: porta exposta no host (evite conflito se já tiver MySQL local).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bolao
DB_USERNAME=bolao
DB_PASSWORD=bolao123
DB_ROOT_PASSWORD=root123
DB_EXTERNAL_PORT=3306

# ─── Sessão / Cache ───────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_NAME_API_SYNC=api-sync
QUEUE_NAME_API_FUNNEL=api-funnel
QUEUE_NAME_SCORING=scoring
QUEUE_NAME_RANKING=ranking
QUEUE_NAME_MAIL=mail
QUEUE_NAME_BROADCAST=broadcast

HORIZON_NAME="Bolão Copa"
HORIZON_PREFIX=bolao_horizon:

CACHE_STORE=database

# ─── Redis ────────────────────────────────────────────────────────────────────
# REDIS_HOST deve ser "redis" quando rodando via Docker Compose.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Email ────────────────────────────────────────────────────────────────────
MAIL_MAILER=kinghost_api
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
KINGHOST_SMTP_API_URL=https://api.smtplw.com.br/v1
KINGHOST_SMTP_API_TOKEN=
KINGHOST_SMTP_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
KINGHOST_SMTP_FROM_NAME="${MAIL_FROM_NAME}"
KINGHOST_SMTP_TIMEOUT=15
KINGHOST_SMTP_RETRY_TIMES=3
KINGHOST_SMTP_RETRY_SLEEP=500
KINGHOST_SMTP_MONTHLY_LIMIT=10000
EMAIL_MONTHLY_QUOTA=10000
EMAIL_LIMIT_POOL_INVITE_SENDER_HOUR=20
EMAIL_LIMIT_POOL_INVITE_RECIPIENT_DAY=3
EMAIL_LIMIT_PASSWORD_RESET_EMAIL_HOUR=3
EMAIL_LIMIT_EMAIL_VERIFICATION_USER_HOUR=3
EMAIL_LIMIT_TEMP_PASSWORD_USER_DAY=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Gere com: php artisan webpush:vapid  (requer minishlink/web-push)
# Ou use: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@bolao.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# ─── Vite (frontend) ──────────────────────────────────────────────────────────
# APP_PORT: porta HTTP do app no host (padrão 8080).
# VITE_REVERB_HOST / VITE_REVERB_PORT: endereço que o BROWSER usa para o WebSocket.
# Em desenvolvimento local via Docker, o browser acessa localhost:REVERB_PORT
# que o nginx proxy-eia para o container reverb internamente.
APP_PORT=8080
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY=bolao-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# ─── Football APIs ────────────────────────────────────────────────────────────
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_TOKEN=

# ─── Reverb (WebSocket) ───────────────────────────────────────────────────────
# REVERB_SERVER_HOST / REVERB_SERVER_PORT: onde o servidor Reverb escuta DENTRO
# do container. Não altere sem ajustar o docker/reverb/start.sh.
# REVERB_HOST / REVERB_PORT / REVERB_SCHEME: usados pelo Laravel para montar
# URLs de broadcast (deve bater com o que o browser acessa via nginx).
# REVERB_APP_KEY deve ser igual a VITE_REVERB_APP_KEY.
REVERB_APP_ID=bolao-app
REVERB_APP_KEY=bolao-key
REVERB_APP_SECRET=bolao-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http

# ─── Admin padrão ────────────────────────────────────────────────────────────
# Altere antes de rodar em produção.
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@bolao.local
DEFAULT_ADMIN_PHONE=5500000000000
DEFAULT_ADMIN_PASSWORD=ChangeMe!123

# ─── API Football ─────────────────────────────────────────────────────────────
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_ENABLED=true
API_FOOTBALL_WC_LEAGUE_ID=1
API_FOOTBALL_WC_SEASON=2026
API_FOOTBALL_BSA_LEAGUE_ID=71
API_FOOTBALL_BSA_SEASON=2026
API_FOOTBALL_TOKEN=
API_FOOTBALL_TIMEOUT=20
API_FOOTBALL_RETRY_TIMES=2
API_FOOTBALL_RETRY_SLEEP_MS=1000
API_FOOTBALL_RATE_LIMIT_RPH=7500
API_FOOTBALL_RATE_LIMIT_RPM=125
API_FOOTBALL_RATE_MAX_WAIT_SECONDS=30
API_FOOTBALL_RESPONSE_CACHE_ENABLED=true
API_FOOTBALL_RESPONSE_CACHE_TTL=30

API_INTEGRATION_PROJECT_MATCH_DETAILS=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IDENTITY=5
LOGIN_RATE_LIMIT_DECAY_SECONDS_PER_IDENTITY=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=25
LOGIN_RATE_LIMIT_DECAY_SECONDS_PER_IP=60

# ─── PWA ──────────────────────────────────────────────────────────────────────
PWA_MINIMUM_SUPPORTED_VERSION=dev
PWA_BUILD_ID=dev
PWA_KILL_SWITCH=false
PWA_FEATURE_ENABLED=true
PWA_FEATURE_OFFLINE_PREDICTIONS_QUEUE=false
PWA_FEATURE_PUSH_NOTIFICATIONS=false
PWA_FEATURE_REALTIME_RANKINGS=false
